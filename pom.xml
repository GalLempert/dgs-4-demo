<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 2.4.2 parent gives us dependency management for Spring, Hibernate 5.4,
        Spring Data JPA, Jackson etc. The DGS platform BOM (imported below) adds management
        for the DGS framework and graphql-java.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.4.2</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>dgs-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>dgs-demo</name>
    <description>DGS 4 GraphQL demo - reusable GraphQL infrastructure + Person domain</description>

    <modules>
        <module>graphql-infrastructure</module>
        <module>company-service</module>
        <module>person-service</module>
    </modules>

    <properties>
        <java.version>11</java.version>
        <dgs.version>4.9.25</dgs.version>
        <!--
            CONFLICT RESOLUTION:
            Spring Boot 2.4.2 manages Kotlin 1.4.21, but DGS 4.9.x is compiled against
            Kotlin 1.5.x (the DGS framework itself is written in Kotlin). Letting Boot
            downgrade kotlin-stdlib to 1.4.21 causes NoSuchMethodError/NoClassDefFoundError
            at runtime inside DGS. Overriding the version property Boot uses fixes it.
            See README.md ("Library conflicts and your options") for alternatives.
        -->
        <kotlin.version>1.5.32</kotlin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Server-side JSON Schema validation (draft-07) via Everit; org.json-based,
                 so it is independent of the Jackson line Boot 2.4.2 manages -->
            <dependency>
                <groupId>com.github.erosb</groupId>
                <artifactId>everit-json-schema</artifactId>
                <version>1.14.4</version>
            </dependency>
            <!-- DGS BOM: manages all com.netflix.graphql.dgs artifacts + graphql-java 17.3 -->
            <dependency>
                <groupId>com.netflix.graphql.dgs</groupId>
                <artifactId>graphql-dgs-platform-dependencies</artifactId>
                <version>${dgs.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>graphql-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Off-the-shelf GraphQL Playground UI at /playground. Assets are bundled in
                 the jar (no CDN by default), so it still works offline. Kickstart 11.x is
                 the line built for Spring Boot 2.x. -->
            <dependency>
                <groupId>com.graphql-java-kickstart</groupId>
                <artifactId>playground-spring-boot-starter</artifactId>
                <version>11.1.0</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>company-service</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
