{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "person-update",
  "description": "Server-side constraints for the partial-update person payloads (Mutation.updatePersons and the updateInput of Mutation.saveOrUpdatePerson) - same per-field rules as person-create; fields are only constrained when present.",
  "type": "object",
  "properties": {
    "firstName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "lastName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 128
    },
    "nickname": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "birthDate": {
      "type": "string",
      "format": "date"
    },
    "salary": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000000
    },
    "heightCm": {
      "type": "integer",
      "minimum": 50,
      "maximum": 260
    },
    "weightKg": {
      "type": "number",
      "minimum": 2,
      "maximum": 500
    },
    "hobbies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64
      }
    },
    "phoneNumbers": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^\\+?[0-9][0-9\\- ]{6,18}[0-9]$"
          }
        }
      }
    },
    "address": {
      "type": "object",
      "properties": {
        "houseNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "zipCode": {
          "type": "string",
          "pattern": "^[0-9]{5,7}$"
        }
      }
    }
  }
}
