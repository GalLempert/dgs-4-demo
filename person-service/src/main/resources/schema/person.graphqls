# Common scalars, EnumValue, DateFormat and the *Filter input types come from
# graphql-infrastructure's schema/common.graphqls - do not redeclare them here.

type Query {
    personById(id: ID!): Person
    allPersons: [Person!]!
    personsByCity(city: String!): [Person!]!
    "Filtered search; filters combine with AND. Guarded by the query result cap."
    persons(filter: PersonFilter): [Person!]!

    """
    Replication feed: the next bulkSize persons whose replication sequence is
    strictly greater than the given sequence, in sequence order. Deleted persons are
    included (in the deleted part) so clients can mirror deletions. With a filter,
    updated/deleted contain only matching persons and filteredOutIds lists the ids in
    the page that no longer match - drop those locally. Poll again from nextSequence.
    """
    personsBySequence(sequence: Long!, bulkSize: Int!, filter: PersonFilter): PersonReplicationPage!

    "Counts matching persons; soft-deleted rows are excluded unless includeDeleted."
    countPersonsByFilter(filter: PersonFilter, includeDeleted: Boolean = false): Int!

    "Highest replication sequence in the person table (0 when empty) - the live tail to start polling from."
    personMaxSequence: Long!
}

"One page of the personsBySequence replication feed"
type PersonReplicationPage {
    "Live persons in the page that match the filter (all live persons when no filter): upsert locally"
    updated: [Person!]!
    "Soft-deleted persons in the page that match the filter: delete locally"
    deleted: [Person!]!
    "Ids in the page that do NOT match the filter: drop any local copy"
    filteredOutIds: [ID!]!
    """
    Resume point for the next poll: the highest sequence in the page. When the page is
    empty (client caught up, or sent a sequence beyond the tail) this snaps back to the
    table's actual maximum sequence, so an over-shot client keeps polling from a real
    position - the feed is strictly-greater-than, so re-sending it yields an empty page
    until the next write.
    """
    nextSequence: Long!
}

type Mutation {
    createPerson(input: CreatePersonInput!): Person!
    updatePersonSalary(id: ID!, salary: Float!): Person!
    deletePerson(id: ID!): Boolean!
}

"Implements the shared technical-truth interfaces: same id/version/timestamps/sequence/deleted shape as every other resource"
type Person implements ReplicatedResource & Resource {
    id: ID!
    "Optimistic-locking counter, incremented on every update"
    version: Long!
    firstName: String!
    lastName: String!
    "Calculated by the service layer"
    fullName: String!
    email: String!
    nickname: String
    "Renders in the requested format (@GraphQLTemporal on PersonView)"
    birthDate(format: DateFormat = ISO): String
    "Calculated by the service layer from birthDate"
    age: Int
    "Enriched from the enum catalog (@GraphQLEnum on PersonView)"
    gender: EnumValue
    "Annual gross salary"
    salary: Float
    "Calculated by the service layer: monthly salary after flat income tax"
    monthlyNetSalary: Float
    active: Boolean!
    "Renders in the requested format (@GraphQLTemporal on PersonView)"
    hireDate(format: DateFormat = ISO): String
    "Calculated by the service layer from hireDate"
    yearsOfService: Int
    heightCm: Int
    weightKg: Float
    "Calculated by the service layer from height and weight"
    bmi: Float
    address: Address
    phoneNumbers: [PhoneNumber!]!
    hobbies: [String!]!
    "Renders in the requested format (@GraphQLTemporal, inherited from ResourceView)"
    createdAt(format: DateFormat = ISO): String
    "Renders in the requested format (@GraphQLTemporal, inherited from ResourceView)"
    updatedAt(format: DateFormat = ISO): String
    "Replication sequence, re-assigned on every write; drives the personsBySequence feed"
    sequence: Long!
    "Soft-delete marker; deleted persons appear only in the replication feed"
    deleted: Boolean!
}

type Address {
    street: String
    houseNumber: Int
    city: String
    zipCode: String
    country: String
}

type PhoneNumber {
    type: PhoneType!
    number: String!
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum PhoneType {
    MOBILE
    HOME
    WORK
}

input CreatePersonInput {
    firstName: String!
    lastName: String!
    email: String!
    nickname: String
    birthDate: Date
    gender: Gender
    salary: Float
    active: Boolean
    hireDate: Date
    heightCm: Int
    weightKg: Float
    address: AddressInput
    phoneNumbers: [PhoneNumberInput!]
    hobbies: [String!]
}

input AddressInput {
    street: String!
    houseNumber: Int
    city: String!
    zipCode: String
    country: String
}

input PhoneNumberInput {
    type: PhoneType!
    number: String!
}

"Which Person fields are filterable, each with its type's predicate set"
input PersonFilter {
    firstName: StringFilter
    lastName: StringFilter
    email: StringFilter
    nickname: StringFilter
    "Filters on the stored enum code, e.g. equals FEMALE"
    gender: StringFilter
    salary: FloatFilter
    heightCm: IntFilter
    weightKg: FloatFilter
    active: BooleanFilter
    birthDate: DateFilter
    hireDate: DateFilter
    address: AddressFilter
}

input AddressFilter {
    street: StringFilter
    city: StringFilter
    zipCode: StringFilter
    country: StringFilter
}
