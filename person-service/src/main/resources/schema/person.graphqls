# Custom scalars registered by the graphql-infrastructure module
scalar Date
scalar DateTime

"Output format for temporal fields annotated with @GraphQLTemporal on the model"
enum DateFormat {
    ISO
    UNIX
    RFC_1123
}

"An enum code enriched with human-readable data from the enum catalog"
type EnumValue {
    code: String!
    label: String!
    description: String
}

type Query {
    personById(id: ID!): Person
    allPersons: [Person!]!
    personsByCity(city: String!): [Person!]!
}

type Mutation {
    createPerson(input: CreatePersonInput!): Person!
    updatePersonSalary(id: ID!, salary: Float!): Person!
    deletePerson(id: ID!): Boolean!
}

type Person {
    id: ID!
    firstName: String!
    lastName: String!
    "Calculated by the service layer"
    fullName: String!
    email: String!
    nickname: String
    "Renders in the requested format (@GraphQLTemporal on PersonView)"
    birthDate(format: DateFormat = ISO): String
    "Calculated by the service layer from birthDate"
    age: Int
    "Enriched from the enum catalog (@GraphQLEnum on PersonView)"
    gender: EnumValue
    "Annual gross salary"
    salary: Float
    "Calculated by the service layer: monthly salary after flat income tax"
    monthlyNetSalary: Float
    active: Boolean!
    "Renders in the requested format (@GraphQLTemporal on PersonView)"
    hireDate(format: DateFormat = ISO): String
    "Calculated by the service layer from hireDate"
    yearsOfService: Int
    heightCm: Int
    weightKg: Float
    "Calculated by the service layer from height and weight"
    bmi: Float
    address: Address
    phoneNumbers: [PhoneNumber!]!
    hobbies: [String!]!
    "Renders in the requested format (@GraphQLTemporal on PersonView)"
    createdAt(format: DateFormat = ISO): String
}

type Address {
    street: String
    houseNumber: Int
    city: String
    zipCode: String
    country: String
}

type PhoneNumber {
    type: PhoneType!
    number: String!
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum PhoneType {
    MOBILE
    HOME
    WORK
}

input CreatePersonInput {
    firstName: String!
    lastName: String!
    email: String!
    nickname: String
    birthDate: Date
    gender: Gender
    salary: Float
    active: Boolean
    hireDate: Date
    heightCm: Int
    weightKg: Float
    address: AddressInput
    phoneNumbers: [PhoneNumberInput!]
    hobbies: [String!]
}

input AddressInput {
    street: String!
    houseNumber: Int
    city: String!
    zipCode: String
    country: String
}

input PhoneNumberInput {
    type: PhoneType!
    number: String!
}
