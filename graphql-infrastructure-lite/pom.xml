<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>dgs-demo</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>graphql-infrastructure-lite</artifactId>
    <name>graphql-infrastructure-lite</name>
    <description>
        The bare-minimum reusable GraphQL infrastructure: DGS loads and serves the SDL
        schema, a dispatch controller wires resolver beans to schema coordinates
        (fail-fast on typos) and dispatches each request to them, and an adapter lets
        existing graphql-java DataFetcher classes plug in unchanged. Nothing else -
        no persistence, no validation, no filtering. See docs/LITE.md.
    </description>

    <dependencies>
        <!-- Brings graphql-java, schema loading from classpath:schema/*.graphqls
             and the /graphql endpoint -->
        <dependency>
            <groupId>com.netflix.graphql.dgs</groupId>
            <artifactId>graphql-dgs-spring-boot-starter</artifactId>
        </dependency>
        <!-- Spring core annotations (@Component etc.) - the DGS starter does not
             expose spring-context at compile scope -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
